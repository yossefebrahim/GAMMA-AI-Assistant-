<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The ONLY network use is the one-time model download (Principle I). INTERNET is required
         to fetch it; ACCESS_NETWORK_STATE lets background_downloader react to connectivity. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- background_downloader runs the ~2.4 GB download under an Android foreground service so it
         survives app use/backgrounding (R2, Principle IV/VIII). FOREGROUND_SERVICE_DATA_SYNC is
         the typed permission required on Android 14+; POST_NOTIFICATIONS shows the progress
         notification (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Image input (002): the camera capture path needs a runtime CAMERA grant, requested through
         MediaPermissionService (002 R3). The photo *library* path uses the Android Photo Picker,
         which is permissionless on modern Android — it grants per-image access to the single image
         the user chooses — so no READ_MEDIA_IMAGES / storage permission is declared (Principle I:
         minimize the permission surface). image_picker declares the camera <queries>/feature entries
         it needs; this is the app-level runtime permission. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Audio input (003): mic capture for voice clips, requested at first mic tap through
         MediaPermissionService (003 R5). Exactly this permission, nothing broader (no storage /
         background-audio permissions — contracts/media_permission.md #4). `record` declares it in
         its own manifest too; the app manifest is the audited surface. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Function calling (004): the `set_timer` tool fires AlarmClock.ACTION_SET_TIMER via
         android_intent_plus (R4, spec Q2). SET_ALARM is a NORMAL permission (auto-granted, no
         runtime prompt) authorizing the clock-app hand-off. The intent is an on-device OS hand-off,
         not network egress — no new network/storage surface (Principle I). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>

    <application
        android:label="ai_assistant"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Android 14+ (API 34+) requires a foreground service to DECLARE its
             foregroundServiceType in the manifest; the runtime type requested must be a subset.
             WorkManager's generic SystemForegroundService (pulled in by background_downloader) is
             declared by the androidx.work library WITHOUT a type, so promoting the ~2.4 GB model
             download to a foreground service throws
             `IllegalArgumentException: foregroundServiceType 0x1 is not a subset of 0x0` and
             crashes main (a crash-loop once WorkManager persists the job). Merge `dataSync` onto
             it — matching our FOREGROUND_SERVICE_DATA_SYNC permission. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Disable Impeller → fall back to the Skia/OpenGL backend. The stable Flutter 3.44.1
             engine defaults to Impeller-Vulkan, which crashes on this class of Mali GPU driver
             (Mali-G68 on the A34 baseline): the driver rejects Impeller's R8 / RGBA_10101010
             gralloc buffer formats ("Unrecognized and/or unsupported format ... TEXTURE + RENDER
             + HWC"), killing the render thread (SIGKILL) within seconds of first frame. Skia is
             solid on Mali. Revisit when Impeller's Vulkan backend supports these drivers. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Function calling (004 R4): Android 11+ package visibility — without this <queries>
             entry, resolving AlarmClock.ACTION_SET_TIMER (the `set_timer` tool's hand-off) fails
             even with SET_ALARM granted. The handler maps an unresolved intent to a structured
             `no clock app available` error (FR-015). -->
        <intent>
            <action android:name="android.intent.action.SET_TIMER"/>
        </intent>
    </queries>
</manifest>
